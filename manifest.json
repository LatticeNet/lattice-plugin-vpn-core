{
  "schema": "lattice.plugin.manifest.v2",
  "id": "latticenet.vpn-core",
  "name": "vpn-core (sing-box)",
  "type": "system",
  "capabilities": [
    "node:read",
    "network:plan",
    "network:apply",
    "task:run"
  ],
  "version": "0.8.0-alpha.1",
  "publisher": "latticenet",
  "signature_ed25519": "fqjO/C+wYtwpwa4j2TDGGPym8gSz4ev2qwy7bQL/wOCF3p8ocbTSsY7CiTKhdq9iG1WOrhuPA8n2bUdyJ9qHBg==",
  "bundle": {
    "format": "tar+gzip",
    "digest_sha256": "0dd37845c55b190720ddbeeea94daff2d5768431e964377bf5a0ab95ccec4b96"
  },
  "runtime": {
    "protocol": "stdio-json-v1",
    "entrypoints": {
      "linux/amd64": "bin/linux-amd64/plugin",
      "linux/arm64": "bin/linux-arm64/plugin"
    }
  },
  "ui_runtime": {
    "mode": "sandbox",
    "entrypoint": "ui/index.html",
    "bridge_version": "1"
  },
  "compatibility": {
    "server": "\u003e=0.2.1",
    "dashboard_host": "\u003e=1",
    "runtime_protocol": "\u003e=1"
  },
  "ui": {
    "nav": [
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Lines",
        "route": "lines",
        "icon": "Radar",
        "scopes": [
          "proxy:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Users",
        "route": "users",
        "icon": "Users",
        "scopes": [
          "proxy:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Node Profiles",
        "route": "profiles",
        "icon": "ServerCog",
        "scopes": [
          "proxy:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Subscriptions",
        "route": "subscriptions",
        "icon": "Link",
        "scopes": [
          "proxy:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Usage",
        "route": "usage",
        "icon": "Gauge",
        "scopes": [
          "proxy:read"
        ]
      }
    ],
    "views": [
      {
        "route": "lines",
        "title": "Lines",
        "kind": "sandbox"
      },
      {
        "route": "users",
        "title": "Users",
        "kind": "sandbox"
      },
      {
        "route": "profiles",
        "title": "Node Profiles",
        "kind": "sandbox"
      },
      {
        "route": "subscriptions",
        "title": "Subscriptions",
        "kind": "sandbox"
      },
      {
        "route": "usage",
        "title": "Usage",
        "kind": "sandbox"
      }
    ]
  },
