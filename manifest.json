{
  "schema": "lattice.plugin.manifest.v2",
  "id": "latticenet.vpn-core",
  "name": "vpn-core (sing-box)",
  "type": "system",
  "capabilities": [
    "node:read",
    "network:plan",
    "network:apply",
    "task:run"
  ],
  "version": "0.8.0-alpha.3",
  "publisher": "latticenet",
  "signature_ed25519": "4fmv4SpK6U8oGaI5rq+a5gbOrbgtjaI47u5BWYubfRYIWOCr/d9rerP4MSvgg10EHkHIh3U3X4E6exM0HgdTAQ==",
  "bundle": {
    "format": "tar+gzip",
    "digest_sha256": "7d18513f4343f53164bd6200b2378a8386c43f08407e89242af7c1ebc2691a73"
  },
  "runtime": {
    "protocol": "stdio-json-v1",
    "entrypoints": {
      "linux/amd64": "bin/linux-amd64/plugin",
      "linux/arm64": "bin/linux-arm64/plugin"
    }
  },
  "ui_runtime": {
    "mode": "sandbox",
    "entrypoint": "ui/index.html",
    "bridge_version": "1"
  },
  "compatibility": {
    "server": "\u003e=0.2.1",
    "dashboard_host": "\u003e=1",
    "runtime_protocol": "\u003e=1"
  },
  "ui": {
    "nav": [
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Lines",
        "route": "lines",
        "icon": "Radar",
        "scopes": [
          "proxy:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Users",
        "route": "users",
        "icon": "Users",
        "scopes": [
          "proxy:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Node Profiles",
        "route": "profiles",
        "icon": "ServerCog",
        "scopes": [
          "proxy:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Usage",
        "route": "usage",
        "icon": "Gauge",
        "scopes": [
          "proxy:read"
        ]
      }
    ],
    "views": [
      {
        "route": "lines",
        "title": "Lines",
        "kind": "sandbox"
      },
      {
        "route": "users",
        "title": "Users",
        "kind": "sandbox"
      },
      {
        "route": "profiles",
        "title": "Node Profiles",
        "kind": "sandbox"
      },
      {
        "route": "usage",
        "title": "Usage",
        "kind": "sandbox"
      }
    ]
  },
  "interfaces": [
    {
      "service": "latticenet.vpn-core/nodes",
      "methods": [
        {
          "name": "export",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        },
        {
          "name": "list",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        }
      ]
    },
    {
      "service": "latticenet.vpn-core/lines",
      "methods": [
        {
          "name": "list",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        },
        {
          "name": "get",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        }
      ]
    },
    {
      "service": "latticenet.vpn-core/users",
      "methods": [
        {
          "name": "list",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        },
        {
          "name": "get",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        }
      ]
    },
    {
      "service": "latticenet.vpn-core/users-admin",
      "methods": [
        {
          "name": "create",
          "effect": "write",
          "scopes": [
            "proxy:admin"
          ]
        },
        {
          "name": "update",
          "effect": "write",
          "scopes": [
            "proxy:admin"
          ]
        },
        {
          "name": "delete",
          "effect": "write",
          "scopes": [
            "proxy:admin"
          ]
        },
        {
          "name": "bind",
          "effect": "write",
          "scopes": [
            "proxy:admin"
          ]
        },
        {
          "name": "unbind",
          "effect": "write",
          "scopes": [
            "proxy:admin"
          ]
        }
      ]
    },
    {
      "service": "latticenet.vpn-core/profiles",
      "methods": [
        {
          "name": "query",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        },
        {
          "name": "settings",
          "effect": "read",
          "scopes": [
            "node:read"
          ]
        },
        {
          "name": "configure",
          "effect": "write",
          "scopes": [
            "node:admin",
            "task:run"
          ]
        }
      ]
    },
    {
      "service": "latticenet.vpn-core/usage",
      "methods": [
        {
          "name": "query",
          "effect": "read",
          "scopes": [
            "proxy:read"
          ]
        }
      ]
    }
  ]
}
