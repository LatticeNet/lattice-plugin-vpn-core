{
  "schema": "lattice.plugin.manifest.v2",
  "id": "latticenet.vpn-core",
  "name": "vpn-core (sing-box)",
  "type": "system",
  "capabilities": [
    "node:read",
    "network:plan",
    "network:apply",
    "task:run"
  ],
  "version": "0.8.0-alpha.6",
  "publisher": "latticenet",
  "signature_ed25519": "dsikXC55Vz0F9EEK/WNii0f4aJeIX+y/C1vZ32yOOc1wyDWE522Y4yBz/+OTxdaM1k3SKAAx/vgF+yo1XvbOCA==",
  "bundle": {
    "format": "tar+gzip",
    "digest_sha256": "d2e681a6a808d8a1f19b941a5067969edb7c601d2e8780256aca7343aad88d86"
  },
  "runtime": {
    "protocol": "stdio-json-v1",
    "entrypoints": {
      "linux/amd64": "bin/linux-amd64/plugin",
      "linux/arm64": "bin/linux-arm64/plugin"
    }
  },
  "ui_runtime": {
    "mode": "sandbox",
    "entrypoint": "ui/index.html",
    "bridge_version": "1"
  },
  "compatibility": {
    "server": "\u003e=0.2.2-alpha.2",
    "dashboard_host": "\u003e=1",
    "runtime_protocol": "\u003e=1"
  },
  "ui": {
    "nav": [
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Lines",
        "route": "lines",
        "icon": "Radar",
        "scopes": [
          "vpncore:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Users",
        "route": "users",
        "icon": "Users",
        "scopes": [
          "vpncore:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Node Profiles",
        "route": "profiles",
        "icon": "ServerCog",
        "scopes": [
          "vpncore:read"
        ]
      },
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Usage",
        "route": "usage",
        "icon": "Gauge",
        "scopes": [
          "vpncore:read"
        ]
      }
    ],
    "views": [
      {
        "route": "lines",
        "title": "Lines",
        "kind": "sandbox"
      },
      {
        "route": "users",
        "title": "Users",
        "kind": "sandbox"
      },
      {
        "route": "profiles",
        "title": "Node Profiles",
        "kind": "sandbox"
      },
      {
        "route": "usage",
        "title": "Usage",
        "kind": "sandbox"
      }
    ]
  },
  "interfaces": [
    {
      "service": "latticenet.vpn-core/nodes",
      "methods": [
        {
          "name": "export",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        },
        {
          "name": "list",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        }
      ],
      "backing": "core"
    },
    {
      "service": "latticenet.vpn-core/lines",
      "methods": [
        {
          "name": "list",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        },
        {
          "name": "get",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        },
        {
          "name": "sync_metadata",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "reattach",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        }
      ],
      "backing": "core"
    },
    {
      "service": "latticenet.vpn-core/users",
      "methods": [
        {
          "name": "list",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        },
        {
          "name": "get",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        }
      ],
      "backing": "core"
    },
    {
      "service": "latticenet.vpn-core/users-admin",
      "methods": [
        {
          "name": "create",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "update",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "delete",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "bind",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "unbind",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "plan_add",
          "effect": "plan",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "plan_remove",
          "effect": "plan",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "plan_update",
          "effect": "plan",
          "scopes": [
            "vpncore:admin"
          ]
        },
        {
          "name": "rotate",
          "effect": "write",
          "scopes": [
            "vpncore:admin"
          ]
        }
      ],
      "backing": "core"
    },
    {
      "service": "latticenet.vpn-core/profiles",
      "methods": [
        {
          "name": "query",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        },
        {
          "name": "settings",
          "effect": "read",
          "scopes": [
            "node:read"
          ]
        },
        {
          "name": "configure",
          "effect": "write",
          "scopes": [
            "node:admin",
            "task:run"
          ]
        }
      ],
      "backing": "core"
    },
    {
      "service": "latticenet.vpn-core/usage",
      "methods": [
        {
          "name": "query",
          "effect": "read",
          "scopes": [
            "vpncore:read"
          ]
        }
      ],
      "backing": "core"
    }
  ]
}
